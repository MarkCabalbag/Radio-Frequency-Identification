PORT=7000
NODE_ENV=development
MONGO_URI=mongodb+srv://user:pass@cluster/dbname
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
# Comma-separated list of allowed frontend origins, e.g. https://my-app.vercel.app
# "*" allows any origin (warned about in production).
CORS_ORIGIN=*
# Shared secret the Arduino sends in the "x-device-key" header.
# Leave empty ONLY until the firmware is updated; empty means device routes stay open.
DEVICE_API_KEY=